# FRIENDLI TRIPZ — PRODUCTION ENVIRONMENT VARIABLES EXAMPLE
# Copy to .env.local for development.
# NEVER commit production secrets to version control.

# ============================================================================
# 1. SUPABASE INFRASTRUCTURE
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================================================
# 2. APPLICATION CONFIGURATION & AUTHENTICATION
# ============================================================================
NEXT_PUBLIC_APP_URL=https://friendlitripz.com
NEXTAUTH_SECRET=your-nextauth-secret-32-chars
JWT_SECRET=your-jwt-secret-min-32-chars

# ============================================================================
# 3. PAYMENT GATEWAY (RAZORPAY)
# ============================================================================
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_SECRET=your_razorpay_live_secret

# ============================================================================
# 4. COMMUNICATIONS ENGINE (WHATSAPP & EMAIL)
# ============================================================================
NEXT_PUBLIC_WHATSAPP_NUMBER=917603967190
WHATSAPP_API_KEY=your-whatsapp-cloud-api-key
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-id

EMAIL_PROVIDER=resend # resend | smtp
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=re_your_smtp_password

# ============================================================================
# 5. MAPS, MONITORING & ANALYTICS
# ============================================================================
GOOGLE_MAPS_API_KEY=AIzaSy_your_google_maps_api_key
SENTRY_DSN=https://your-dsn@sentry.io/123456
ANALYTICS_ID=G-XXXXXXXXXX
